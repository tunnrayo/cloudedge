# Copy to .env.local for local work. NEVER commit real values.
# Public website address (no trailing slash). Used for sitemap and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend (https://resend.com) API key. Without it the forms show an honest "not configured" message.
RESEND_API_KEY=
# Where inquiries are delivered. Defaults to the official company email if left empty.
INQUIRY_TO_EMAIL=
# Verified sender, e.g. "Cloud Edge Website <noreply@yourdomain.com>". Needs a domain verified in Resend.
INQUIRY_FROM_EMAIL=
