# =====================================================================
# Cloud Edge website settings
# Copy this file to ".env.local" for your own computer.
# On the hosting platform (Railway, Vercel...) add the same names under "Variables".
# NEVER put real values in this file or commit .env.local to GitHub.
# =====================================================================

# --- Website address -------------------------------------------------
# Public address of the website, no trailing slash. Used in the sitemap,
# search-engine and social-sharing tags. Must be set BEFORE "npm run build".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (stores inquiries; powers the /admin area) -------------
# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
# Railway: add a PostgreSQL service and reference its DATABASE_URL variable.
# Leave empty on your own computer: inquiries are then saved to .data/inquiries.json.
DATABASE_URL=
# Set to "true" if your database provider requires SSL and the URL has no sslmode=require.
DATABASE_SSL=
# Only if your provider uses a self-signed certificate: set to "false". Leave empty otherwise.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Advanced: in production without DATABASE_URL, set to "file" to save inquiries to a local file.
# Not recommended: most hosts delete local files on every deploy.
INQUIRY_STORAGE=

# --- Admin area (/admin) ---------------------------------------------
# The admin area stays LOCKED until both of these are set.
# Password: at least 12 characters. Use a long, unique passphrase.
ADMIN_PASSWORD=
# Secret used to sign the login cookie: at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Email notifications (optional, via https://resend.com) ----------
# When set, every inquiry is also emailed to the company mailbox.
RESEND_API_KEY=
# Verified sender, e.g. "Cloud Edge Website <noreply@yourdomain.com>". Needs a domain verified in Resend.
# (For a quick test before you own a domain, Resend allows: onboarding@resend.dev — it can only
#  deliver to the email address you signed up to Resend with.)
INQUIRY_FROM_EMAIL=
# Where inquiries are sent. Defaults to the official company email if left empty.
INQUIRY_TO_EMAIL=
