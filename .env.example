# =====================================================================
# Cloud Edge website settings — NAMES AND EXPLANATIONS ONLY, NO SECRETS.
# On your computer: copy this file to ".env.local" and fill in what you need.
# On Railway: add the same names under your web service → Variables.
# NEVER put real values in this file or commit .env.local to GitHub.
# =====================================================================

# --- Website address -------------------------------------------------
# Public address of the website, no trailing slash, e.g. https://www.cloudedgetech.com
# SITE_URL is read while the site runs (used for Paystack return links and email links).
SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL is baked into pages at BUILD time (sitemap, social previews). Set it to the same value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (REQUIRED on the live site) ----------------------------
# PostgreSQL connection string. Stores products, orders, customers, payments, inquiries and uploaded images.
# Railway: add a PostgreSQL service, then set this to ${{Postgres.DATABASE_URL}}
# Leave EMPTY on your own computer: a built-in local database is used automatically (folder .data/pglite).
DATABASE_URL=
# "true" if your provider needs SSL and the URL has no sslmode=require (not needed on Railway's private network).
DATABASE_SSL=
# Only for providers with self-signed certificates: "false". Otherwise leave empty.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Maximum database connections per app instance (default 10).
DATABASE_POOL_MAX=

# --- Payments: Paystack (https://dashboard.paystack.com) -------------
# Secret key from Settings → API Keys & Webhooks.
#   sk_test_...  = TEST mode (no real money; use while testing)
#   sk_live_...  = LIVE mode (real payments) — only after your Paystack business account is activated
# Customers are NEVER charged when they send a request. Payment is offered only after they accept a quotation.
# Without a key, online payment is off and you send payment instructions (e.g. bank transfer) from the admin instead.
# Webhook URL to enter in Paystack: https://YOUR-DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Tests only — never set this on the live site.
PAYSTACK_BASE_URL=
# Safety switch for LIVE keys: online payment with an sk_live_ key stays OFF until this is exactly "true".
# Leave empty until you have completed a full test-mode run (request → quote → accept → pay → webhook) on the deployed site.
PAYMENTS_LIVE_ENABLED=

# --- Optional public WhatsApp contact ------------------------------------------
# Only set this to a real company WhatsApp number (international format, e.g. 2348012345678).
# When empty, no WhatsApp link is shown anywhere.
CONTACT_WHATSAPP=

# --- Admin area (/admin) — REQUIRED to manage orders -----------------
# Stays LOCKED until both are set. Password: 12+ characters, long and unique.
ADMIN_PASSWORD=
# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Emails (optional but recommended), via https://resend.com -------
# Without these, orders and inquiries still work; emails are recorded as "not configured".
RESEND_API_KEY=
# Verified sender for contact-form notifications, e.g. "Cloud Edge Website <noreply@yourdomain.com>"
INQUIRY_FROM_EMAIL=
# Where contact/quote inquiries are sent (default: the official company email).
INQUIRY_TO_EMAIL=
# Sender for customer order emails (defaults to INQUIRY_FROM_EMAIL), e.g. "Cloud Edge Orders <orders@yourdomain.com>"
SHOP_FROM_EMAIL=
# Where new paid-order alerts go (defaults to INQUIRY_TO_EMAIL, then the company email).
SHOP_NOTIFY_EMAIL=

# --- Portfolio -------------------------------------------------------
# "true" shows the labelled DEMO concept projects on /portfolio. Default (empty) hides them: only real, approved projects should be public.
SHOW_DEMO_PROJECTS=

# --- Advanced (normally leave empty) ---------------------------------
# Folder for the local development database.
PGLITE_DIR=
# Inquiries: "file" stores them in .data/inquiries.json when there is no DATABASE_URL in production (not recommended).
INQUIRY_STORAGE=
# Allow the built-in local database in production (NOT recommended: data is lost when Railway redeploys).
ALLOW_PGLITE_IN_PRODUCTION=
# Tests only — never set on the live site. Points email sending at a stand-in server.
RESEND_BASE_URL=
